# Acadiv Backend — copy to .env and fill in real values.
# NEVER commit .env. NEVER expose these to the Vite frontend.

NODE_ENV=development
PORT=5000

# Required — MongoDB Atlas connection string (user supplies)
MONGODB_URI=mongodb+srv://mrsmartyy67_db_user:E43QsnxG8bGcAA6b@cluster0.fskxk4a.mongodb.net/

# Auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public site URL (for portfolio share links, canonical refs)
PUBLIC_APP_URL=http://localhost:5173

# Local file uploads (artifacts). Use object storage in production.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
